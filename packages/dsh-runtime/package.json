{
  "name": "@mathmover/dsh-runtime",
  "version": "0.1.0",
  "description": "DeepSeek Harness profile runtime for MathMover（JSONL stdio 协议边界）",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./startup": "./dist/startup.js",
    "./invariant": "./dist/invariant.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/*.js",
    "cordis.patch.yml",
    "README.md",
    "UPSTREAM.md",
    "LICENSE.upstream"
