mathmover.top, www.mathmover.top {
    # 1. 后端 API 路由：将所有 /api/* 的请求直接转给 Python 容器
    # 现在后端已配置为监听 /api/* 路径，所以直接转发即可，无需剥离前缀
    handle /api* {
        reverse_proxy backend:5000 {
            flush_interval -1
        }
    }

    # 2. 前端路由：其他所有页面和资源请求，转给 Next.js 容器
    handle {
        reverse_proxy frontend:3000
    }
}
