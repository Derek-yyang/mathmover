{
  "name": "mathmover-mobile",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:web": "node -e \"require('node:fs').rmSync('www/assets', { recursive: true, force: true })\" && vite build",
    "sync": "npm run build:web && cap sync android",
    "android:debug": "npm run sync && cd android && gradlew assembleDebug --no-daemon --init-script mirrors.init.gradle"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.143",
    "@ai-sdk/google": "^3.0.148",
    "@ai-sdk/openai": "^3.0.145",
    "@ai-sdk/openai-compatible": "3.0.93",
    "@capacitor/android": "7.6.10",
    "@capacitor/app": "^7.1.2",
    "@capacitor/camera": "7.0.5",
    "@capacitor/core": "7.6.10",
    "@capacitor/filesystem": "7.1.9",
    "@capacitor/share": "7.0.4",
    "@capacitor/status-bar": "7.0.6",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "ai": "7.0.176",
    "capacitor-secure-storage-plugin": "^0.12.0",
    "capacitor-stream-http": "0.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.548.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.10",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.5",
    "vite": "^7.3.8"
  }
}
