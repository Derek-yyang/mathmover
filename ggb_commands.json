    "ShowLabel", "SetLabelMode", "SetLabelStyle", "SetCaption",
    "SetVisibleInView", "SetValue", "SetConditionToShowObject",
    "SetTooltipMode", "SetLayer", "SetSeed"
  ],
  "globals": [
    "SetPerspective", "SetAxesVisible", "SetGridVisible",
    "ShowAxes", "ShowGrid", "CenterView", "SetActiveView",
    "ZoomIn", "ZoomOut", "ZoomPadding", "SetViewDirection",
    "SetFontSize", "Execute", "UpdateConstruction", "Delete"
  ]
}
